# Copy this file to .env and put a newly generated key there. Never commit it.
DEEPSEEK_API_KEY=replace-with-a-new-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

HARNESS_PORT=3080
BANKOPS_PORTAL_PORT=8080

# The API starts in mock mode so local smoke tests never spend model tokens.
# Change this to real only after the API contract and MCP services are verified.
BANKOPS_AGENT_RUNNER_MODE=mock
BANKOPS_AGENT_API_PORT=8090
BANKOPS_AGENT_MAX_CONCURRENCY=1
BANKOPS_AGENT_TIMEOUT_MS=300000

# Localhost-only development may use unauthenticated mode. For any shared
# environment, set a strong token and change ALLOW_UNAUTHENTICATED to 0.
BANKOPS_AGENT_API_TOKEN=
BANKOPS_AGENT_API_ALLOW_UNAUTHENTICATED=1
BANKOPS_IDENTITY_INTERNAL_TOKEN=replace-with-at-least-24-random-characters
BANKOPS_IDENTITY_SIGNING_SECRET=replace-with-at-least-32-random-characters
BANKOPS_RUNTIME_INTERNAL_TOKEN=replace-with-at-least-24-random-characters
BANKOPS_RUNTIME_MANAGER_PORT=8970
BANKOPS_BOOTSTRAP_ADMIN_USERNAME=admin
BANKOPS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
BANKOPS_BOOTSTRAP_ADMIN_DISPLAY_NAME=平台管理员
BANKOPS_SESSION_HOURS=8
BANKOPS_COOKIE_SECURE=0
BANKOPS_REGISTRATION_ENABLED=1

# Both Compose projects join the private bankops-network.
BANKOPS_CHANGEINFO_MCP_URL=http://bankops-changeinfo-mcp:8941/mcp
BANKOPS_CMDB_MCP_URL=http://bankops-cmdb-mcp:8942/mcp
BANKOPS_ALERTINFO_MCP_URL=http://bankops-alertinfo-mcp:8943/mcp
BANKOPS_PERFINFO_MCP_URL=http://bankops-perfinfo-mcp:8944/mcp
BANKOPS_KNOWLEDGE_MCP_URL=http://bankops-knowledge-mcp:8952/mcp
BANKOPS_MEMORY_MCP_URL=http://bankops-memory-mcp:8953/mcp
