COMPOSE_PROJECT_NAME=bankops-mcp-hub
TARGET_PLATFORM=linux/amd64
PLAYWRIGHT_PORT=8931
FILESYSTEM_PORT=8932
GIT_PORT=8933
SSH_PORT=8934
ELASTICSEARCH_PORT=9200
POSTGRES_PORT=5432
POSTGRES_DB=bankops
POSTGRES_USER=bankops
POSTGRES_PASSWORD=bankops-local-change-me
POSTGRES_VERSION=17-bookworm
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=bankops-minio
MINIO_ROOT_PASSWORD=bankops-minio-local-change-me
MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-07-21T05-28-08Z
CHANGEINFO_PORT=8941
CMDB_PORT=8942
ALERTINFO_PORT=8943
PERFINFO_PORT=8944
FILE_SERVICE_PORT=8951
KNOWLEDGE_MCP_PORT=8952
MEMORY_MCP_PORT=8953
KNOWLEDGE_REST_PORT=9052
BANKOPS_MAX_UPLOAD_BYTES=20971520
BANKOPS_MAX_DOCUMENT_PAGES=500
BANKOPS_MAX_EXTRACTED_CHARS=5000000
BANKOPS_WORKER_MAX_ATTEMPTS=5
BANKOPS_WORKER_POLL_MS=1000
BANKOPS_WORKER_STALE_MS=600000
KNOWLEDGE_WORKER_REPLICAS=1
BANKOPS_IDENTITY_SIGNING_SECRET=replace-with-the-same-at-least-32-character-secret-as-portal
