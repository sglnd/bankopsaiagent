# Image tags are deliberately explicit. Update, rebuild, test, then export.
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.57.0-noble
NODE_IMAGE=node:22-bookworm-slim
MCP_PROXY_VERSION=6.5.4
