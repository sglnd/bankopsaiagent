BANKOPS_TENANT_ID=tenant-local
BANKOPS_USER_ID=user-local
BANKOPS_DEPARTMENT_ID=dept-operations
BANKOPS_ROLES=OPERATIONS
BANKOPS_WORKSPACE_ID=bankops-default
